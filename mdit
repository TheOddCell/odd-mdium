VERSION=3.1.0

# WebPath and URL parsing
set -o pipefail
sigusr1() {
  printf "\nMDIT $VERSION info"
  printf "\nWEBPATH=%s\n" "$WEBPATH"
  printf "WIDTH=%s HEIGHT=%s\n" "$WIDTH" "$HEIGHT"
  printf "PID=%s\n" "$$\n"
  printf "argv0=%s\n" "$0"
  printf "Thanks for using MDIT!\n"
  printf "\n"
}
if [ -z "$MDITXTRACE" ]; then
  export MDITXTRACE="false"
fi
applyxtrace() {
  if $MDITXTRACE; then
    set -o xtrace
  else
    set +o xtrace
  fi
}
sigusr2() {
  if $MDITXTRACE; then
    export MDITXTRACE="false"
    applyxtrace
  else
    export MDITXTRACE="true"
    applyxtrace
  fi
}
trap 'sigusr1' USR1
trap 'sigusr2' USR2
applyxtrace
trap 'clear;tput rmcup; exit 0' INT
trap 'printf "\033[0m";clear;exec $0 $WEBPATH --automore' TSTP
trap 'printf "\033[0m";clear;exec $0 $WEBPATH' SIGQUIT
tput smcup
clear
WEBPATH="$1"
WIDTH=${COLUMNS:-80};HEIGHT=${LINES:-24};BG=44;FG=97
: "${WEBPATH:=home}"
if [ "$WEBPATH" == "/" ]; then
  WEBPATH="/home"
fi
case "$WEBPATH" in
  http://*|https://*)
    xdg-open "$WEBPATH"
    WEBPATH="/home"
    ;;
  /*)
    ;;
  *)
    WEBPATH="/$WEBPATH"
    ;;
esac
# config.json
if [ -z "$CONFIGDOTJSON" ]; then
  trap 'echo;read -p "Enter URI for config.json: " CONFIGDOTJSON;export CONFIGDOTJSON;clear;tput rmcup;exec $0' TSTP
  TEXT2="MDIT v$VERSION - Choose a site - ^Z to manually choose a config.json"
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then TEXT2="MDIT - Choose a site - ^Z manual config.json";fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then TEXT2="MDIT - Choose a site - ^Z manual";fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then TEXT2="MDIT - Choose - ^Z manual";fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then TEXT2="MDIT v$VERSION";fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then TEXT2="MDIT";fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then TEXT2="MDT";fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then TEXT2="MD";fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then TEXT2="M";fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    clear
    tput rmcup
    echo "Terminal must have an amount of columns!"
    exit 1
  fi
  PAD=$((WIDTH - ${#TEXT2}))
  printf "\033[H\033[${BG}m\033[1;${FG}m%s%${PAD}s\033[0m\n" "$TEXT2" ""
  read -p "Enter website URL: " CONFIGDOTJSON
  export CONFIGDOTJSON="$CONFIGDOTJSON/config.json"
  exec "$0"
fi
CONFIG_JSON="$(curl -fsSL "$CONFIGDOTJSON")"
URL="$(printf '%s' "$CONFIG_JSON" | jq -r '.baseUrl')"
LOGO="$(printf '%s' "$CONFIG_JSON" | jq -r '.logo')"
NAME="$(printf '%s' "$CONFIG_JSON" | jq -r '.siteName')"
LICENCE="$(printf '%s' "$CONFIG_JSON" | jq -r '.licenseBadge')"
# styling
format_text() {
  sed -E '
  # Replace %GAP% with |
  s/%GAP%/|/g

  # Markdown links: [text](url) -> text [url], no color
  s/\[([^]]*)\]\(([^)]*)\)/\1 [\2]/g

  # Headers: #, ##, ###, #### -> yellow
  s/^(#{1,4}) (.*)/\x1b[33m\2\x1b[0m/

  # Quote line: "> " to "| "
  s/^> /| /

  # Bold: **text** (does not clear color)
  s/\*\*([^*]+)\*\*/\x1b[1m\1\x1b[22m/g

  # Italic: *text* (does not clear color)
  s/\*([^*]+)\*/\x1b[3m\1\x1b[23m/g

  # Inline code: `text` -> grey bg, white text
  s/`([^`]+)`/\x1b[100;97m\1\x1b[0m/g
  '
}
# top bar
topbar() {
  LICENCETEXT="$(printf '%s\n' "$LICENCE" \
    | sed -n 's/.*alt="\([^"]*\)".*/ - \1/p')"
  if [ "$WEBPATH" = "/home" ]; then
    WEBPATH2="/"
  else
    WEBPATH2="$WEBPATH"
  fi
  TEXT2="$1"
    if [ -z "$1"             ]; then TEXT2="MDIT v$VERSION - [$NAME]$WEBPATH2$LICENCETEXT";fi
    if [    "$1" = "loading" ]; then TEXT2="MDIT v$VERSION - [...] [$NAME]$WEBPATH2$LICENCETEXT";fi
    if [    "$1" = "error"   ]; then TEXT2="MDIT v$VERSION - [!!!] [$NAME]$WEBPATH2$LICENCETEXT";fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2="MDIT v$VERSION - [$NAME]$WEBPATH2";fi
    if [    "$1" = "loading" ]; then TEXT2="MDIT v$VERSION - [...] [$NAME]$WEBPATH2";fi
    if [    "$1" = "error"   ]; then TEXT2="MDIT v$VERSION - [!!!] [$NAME]$WEBPATH2";fi
  fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2="MDIT - [$NAME]$WEBPATH2";fi
    if [    "$1" = "loading" ]; then TEXT2="MDIT - [...] [$NAME]$WEBPATH2";fi
    if [    "$1" = "error"   ]; then TEXT2="MDIT - [!!!] [$NAME]$WEBPATH2";fi
  fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2="MDIT - wiki$WEBPATH2";fi
    if [    "$1" = "loading" ]; then TEXT2="MDIT - [...] wiki$WEBPATH2";fi
    if [    "$1" = "error"   ]; then TEXT2="MDIT - [!!!] wiki$WEBPATH2";fi
  fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2="wiki$WEBPATH2";fi
    if [    "$1" = "loading" ]; then TEXT2="load wiki$WEBPATH2";fi
    if [    "$1" = "error"   ]; then TEXT2="err wiki$WEBPATH2";fi
  fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2="$WEBPATH2";fi
    if [    "$1" = "loading" ]; then TEXT2="$WEBPATH2";fi
    if [    "$1" = "error"   ]; then TEXT2="err $WEBPATH2";fi
  fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2="$WEBPATH2";fi
    if [    "$1" = "loading" ]; then TEXT2="$WEBPATH2";fi
    if [    "$1" = "error"   ]; then TEXT2="err";fi
  fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2="MDIT";fi
    if [    "$1" = "loading" ]; then TEXT2="MDIT";fi
    if [    "$1" = "error"   ]; then TEXT2="err ";fi
  fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2="   ";fi
    if [    "$1" = "loading" ]; then TEXT2="...";fi
    if [    "$1" = "error"   ]; then TEXT2="!!!";fi
  fi 
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2="  ";fi
    if [    "$1" = "loading" ]; then TEXT2="..";fi
    if [    "$1" = "error"   ]; then TEXT2="!!";fi
  fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    if [ -z "$1"             ]; then TEXT2=" ";fi
    if [    "$1" = "loading" ]; then TEXT2=".";fi
    if [    "$1" = "error"   ]; then TEXT2="!";fi
  fi
  if [ "${#TEXT2}" -ge "$WIDTH" ]; then
    clear
    tput rmcup
    echo "Terminal must have an amount of columns!"
    exit 1
  fi
  PAD=$((WIDTH - ${#TEXT2}))
  printf "\033[H\033[${BG}m\033[1;${FG}m%s%${PAD}s\033[0m\n" "$TEXT2" ""
}
topbar loading
# rendering
also0="$0"
moreable() {
  if [ "$1" = "--automore" ]; then
    if command -v most >/dev/null; then
      most
    elif command -v less >/dev/null; then
      less --use-color
    fi
    tput smcup
    clear
    topbar
    curl -fsSL "$LOGO" 2>/dev/null|kitten icat --align=left -n --use-window-size 50,50,50,50 --detection-timeout=0.1 2>/dev/null
    printf " $NAME | "
    curl -fsSL "$URL/top.md"|format_text
    if [ "$?" != "0" ]; then topbar error; fi
    curl -fsSL "$URL/$WEBPATH.md"|format_text
    if [ "$?" != "0" ]; then topbar error; fi
  else
    more
    printf "\033[H"
    topbar
  fi
}
curl -fsSL "$LOGO" 2>/dev/null|kitten icat --align=left -n --use-window-size 50,50,50,50 --detection-timeout=0.1 2>/dev/null
printf " $NAME | "
curl -fsSL "$URL/top.md"|format_text
if [ "$?" != "0" ]; then topbar error; fi
curl -fsSL "$URL/$WEBPATH.md"|format_text|moreable "$2"
if [ "$?" != "0" ]; then topbar error; fi
# help bar
printf "\033[${HEIGHT};1H"
                                        TEXT="^C exit ^D sidebar ^\ reload,             or type path:"
    if command -v most >/dev/null; then TEXT="^C exit ^D sidebar ^\ reload ^Z use most, or type path:"
  elif command -v less >/dev/null; then TEXT="^C exit ^D sidebar ^\ reload ^Z use less, or type path:"
fi
if [ "${#TEXT}" -ge "$WIDTH" ]; then
                                        TEXT="^C exit ^D sidebar ^\ reload, or type path:"
fi
if [ "${#TEXT}" -ge "$WIDTH" ]; then
                                        TEXT="^C exit ^D sidebar, or type path:"
fi
if [ "${#TEXT}" -ge "$WIDTH" ]; then
                                        TEXT="^C exit or type path:"
fi
if [ "${#TEXT}" -ge "$WIDTH" ]; then
                                        TEXT="type path:"
fi
if [ "${#TEXT}" -ge "$WIDTH" ]; then
                                        TEXT="path:"
fi
if [ "${#TEXT}" -ge "$WIDTH" ]; then
                                        TEXT=":"
fi
if [ "${#TEXT}" -ge "$WIDTH" ]; then
                                        TEXT=""
fi
PAD=$((WIDTH - ${#TEXT}))
LENGTH=$((${#TEXT} + 2))
printf "\033[${BG}m\033[1;${FG}m%s%${PAD}s" "$TEXT" ""
# input parsing
printf "\033[${HEIGHT};${LENGTH}H"
read input
printf "\033[0m"
clear
if [ -n "$input" ]; then
  exec $0 "$input"
fi
exec $0 "/sidebar"
